{
  "name": "evmtrace",
  "version": "0.1.0",
  "description": "EVM transaction tracer and gas profiler — replay a tx, decode the call tree, and see where the gas went",
  "keywords": [
    "ethereum",
    "evm",
    "gas",
    "tracing",
    "profiler",
    "flamegraph",
    "viem",
    "solidity"
  ],
  "license": "MIT",
  "author": "Chris Sun",
  "homepage": "https://github.com/Fzgt/evmtrace#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fzgt/evmtrace.git"
  },
  "bugs": {
    "url": "https://github.com/Fzgt/evmtrace/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "evmtrace": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,mjs,cjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,cjs,json,md,yml,yaml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "viem": "^2.55.19"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.15.0",
    "prettier": "^3.4.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.16.0",
    "vitest": "^3.2.0"
  }
}
